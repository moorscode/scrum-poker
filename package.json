{
  "name": "scrum-poker",
  "version": "1.0.0",
  "description": "Scrum refinement tool",
  "author": "https://github.com/moorscode",
  "private": false,
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prebuild:frontend": "rimraf dist/frontend",
    "prebuild:backend": "rimraf dist/backend",
    "build": "yarn build:backend && yarn build:frontend",
    "build:backend": "nest build",
    "build:frontend": "webpack --mode production --config ./frontend/webpack.config.js",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/backend/main",
    "watch:frontend": "webpack serve --mode development --config ./frontend/webpack.config.js",
    "cs": "eslint \"backend/**/*.ts\" \"frontend/**/*.js\" \"frontend/**/*.vue\" \"tests/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11",
    "@nestjs/config": "^4",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/platform-socket.io": "^11",
    "@nestjs/schedule": "^6",
    "@nestjs/websockets": "^11",
    "reflect-metadata": "^0.2",
    "rxjs": "^7",
    "socket.io": "^4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11",
    "@nestjs/schematics": "^11",
    "@nestjs/testing": "^11",
    "@types/express": "^5",
    "@types/jest": "^29",
    "@types/node": "^24",
    "@types/supertest": "^6",
    "@typescript-eslint/eslint-plugin": "^7",
    "@typescript-eslint/parser": "^7",
    "@vue/test-utils": "^1.3.6",
    "copy-webpack-plugin": "^13",
    "css-loader": "^7",
    "dotenv": "^17",
    "eslint": "^8.57.1",
    "file-loader": "^6.2.0",
    "glob": "^11",
    "html-webpack-plugin": "^5",
    "jest": "^29",
    "rimraf": "^6",
    "sass": "^1",
    "sass-loader": "^16",
    "socket.io-client": "^4",
    "supertest": "^7",
    "ts-jest": "^29",
    "ts-node": "^10",
    "tsconfig-paths": "^4",
    "typescript": "^5",
    "vue": "^2.7.16",
    "vue-eslint-parser": "^9",
    "vue-loader": "^15.11.1",
    "vue-socket.io-extended": "^4.2.0",
    "vue-template-compiler": "^2.7.16",
    "vuex": "^3.6.2",
    "webpack": "^5",
    "webpack-bundle-analyzer": "^4",
    "webpack-cli": "^6",
    "webpack-dev-server": "^5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "./",
    "testRegex": ".*\\.spec\\.(t|j)s$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "(backend|frontend)/src/**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "./tests/bootstrap.ts"
    ]
  }
}
